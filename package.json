{
  "name": "the-tip-sheet",
  "version": "1.0.0",
  "private": true,
  "description": "The Tip Sheet: nail ideas, press-on know-how and small-space style. Static Eleventy site for Netlify.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy && pagefind --site _site",
    "start": "npm run build && eleventy --serve --quiet",
    "check": "node tools/check-site.js",
    "netlify": "npm run build && npm run check",
    "pins": "python3 tools/make_pins.py",
    "dashboard": "node tools/build-dashboard.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "pagefind": "^1.3.0"
  }
}
